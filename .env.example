# Copy to .env and replace every "change-me" value. Never commit .env.

# --- PostgreSQL container (docker-compose.yml) -------------------------------
# Superuser of the container; used only by the init script and for admin work.
POSTGRES_PASSWORD=change-me-superuser
POSTGRES_DB=accessa
# Passwords for the two roles created by docker/postgres/init/01-roles.sh.
ACCESSA_OWNER_PASSWORD=change-me-owner
ACCESSA_APP_PASSWORD=change-me-app

# --- Backend -----------------------------------------------------------------
# Required. Connection used by the running application (least-privilege role).
DATABASE_URL=postgresql+psycopg://accessa_app:change-me-app@localhost:5432/accessa
# Required for Alembic. Schema owner role; used only to run migrations.
MIGRATION_DATABASE_URL=postgresql+psycopg://accessa_owner:change-me-owner@localhost:5432/accessa
# Required. Secret for signing JWTs. Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me
# Required. Fernet key that encrypts every user's TOTP secret (users.mfa_secret_encrypted).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Never commit it. Losing or changing it makes every enrolled MFA secret unreadable:
# all users would then need an admin MFA reset.
MFA_ENCRYPTION_KEY=change-me
# Optional. "production" enables Strict-Transport-Security on HTTPS requests and the
# strict CSP on the API docs pages (default: development).
APP_ENV=development
# Optional. Comma-separated list of allowed frontend origins (default: http://localhost:5173).
CORS_ORIGINS=http://localhost:5173
# Optional. GitHub token for the AI review's pull request fetch (public repos only).
# Without it GitHub allows 60 requests/hour per IP; with it 5,000/hour. A fine-grained
# token with no extra permissions (public repositories, read-only) is enough.
# GITHUB_TOKEN=
# Required for the AI review (requests are sent to api.openai.com). Without them
# "Generate AI review" answers 503 "AI review is not configured".
# OPENAI_API_KEY=
# A model that supports structured outputs (JSON schema), e.g. gpt-4o-mini.
# OPENAI_MODEL=

# --- Tests -------------------------------------------------------------------
# Required for pytest. Throwaway database, connected as the application role. The
# suite drops and re-creates it (name must contain "test"), migrating it as the owner
# role: MIGRATION_DATABASE_URL with the database name swapped, unless
# TEST_MIGRATION_DATABASE_URL is set.
TEST_DATABASE_URL=postgresql+psycopg://accessa_app:change-me-app@localhost:5432/accessa_test
# TEST_MIGRATION_DATABASE_URL=postgresql+psycopg://accessa_owner:change-me-owner@localhost:5432/accessa_test

# --- Demo data -------------------------------------------------------------------
# Optional. Password given to every user by scripts/seed_demo.py (>= 8 characters).
DEMO_PASSWORD=change-me-demo


# API 
OPENAI_API_KEY=
OPENAI_MODEL=