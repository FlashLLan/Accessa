# Accessa production secrets for docker-compose.prod.yml (see DEPLOYMENT.md).
#
# Lives ONLY on the server as .env.production, readable by the deploy user only:
#
#   cp .env.production.example .env.production && chmod 600 .env.production
#
# Never commit it, copy it into an image, or paste it into chat/tickets. It is
# git-ignored (.env.*) and excluded from Docker build contexts (.dockerignore).
#
# Generate every secret on the server, one per line, and paste each value in:
#
#   openssl rand -hex 32                                # each *_PASSWORD (hex: no escaping in URLs)
#   openssl rand -base64 48 | tr -d '\n'; echo          # JWT_SECRET_KEY (>= 32 bytes)
#   openssl rand -base64 32 | tr '+/' '-_'              # MFA_ENCRYPTION_KEY (a Fernet key)
#
# Or fill all generated values in one go (still edit the domain and OpenAI key):
#
#   sed -i \
#     -e "s|^POSTGRES_PASSWORD=.*|POSTGRES_PASSWORD=$(openssl rand -hex 32)|" \
#     -e "s|^ACCESSA_OWNER_PASSWORD=.*|ACCESSA_OWNER_PASSWORD=$(openssl rand -hex 32)|" \
#     -e "s|^ACCESSA_APP_PASSWORD=.*|ACCESSA_APP_PASSWORD=$(openssl rand -hex 32)|" \
#     -e "s|^JWT_SECRET_KEY=.*|JWT_SECRET_KEY=$(openssl rand -base64 48 | tr -d '\n/+=')|" \
#     -e "s|^MFA_ENCRYPTION_KEY=.*|MFA_ENCRYPTION_KEY=$(openssl rand -base64 32 | tr '+/' '-_')|" \
#     .env.production
#
# Keep an offline copy of MFA_ENCRYPTION_KEY and the database passwords (e.g. in
# a password manager): losing MFA_ENCRYPTION_KEY makes every enrolled MFA secret
# unreadable (all users would need an admin MFA reset), and a restored database
# backup needs the role passwords it was created with.

# --- Site -----------------------------------------------------------------------------
# Public hostname. Caddy gets the HTTPS certificate for it automatically; ports 80
# and 443 must reach the server. No DNS of your own needed with sslip.io:
#   accessa.203-0-113-5.sslip.io   (your server's IPv4 with dashes)
# or a free DuckDNS name (accessa.duckdns.org). "localhost" for a local test.
ACCESSA_DOMAIN=accessa.203-0-113-5.sslip.io

# --- PostgreSQL ---------------------------------------------------------------------------
# Superuser of the postgres container: only for the first start and maintenance.
POSTGRES_PASSWORD=change-me
# Schema owner: migrations only (docker compose run ... alembic upgrade head).
# Never given to the running backend.
ACCESSA_OWNER_PASSWORD=change-me
# Application role used by the backend.
ACCESSA_APP_PASSWORD=change-me
# The backend's connection, as the application role, over the private network.
# Keep ${ACCESSA_APP_PASSWORD}: Compose fills it in from the line above.
DATABASE_URL=postgresql+psycopg://accessa_app:${ACCESSA_APP_PASSWORD}@postgres:5432/accessa

# --- Backend ------------------------------------------------------------------------------
JWT_SECRET_KEY=change-me
MFA_ENCRYPTION_KEY=change-me
# AI review: an OpenAI API key and a model that supports structured (JSON schema) output.
OPENAI_API_KEY=change-me
OPENAI_MODEL=gpt-4o-mini
# Optional: read-only token for public repositories (GitHub: 5,000 instead of 60
# requests/hour for submission fetches and AI reviews). Leave empty if not used.
GITHUB_TOKEN=

# NOT here: MIGRATION_DATABASE_URL. It is passed only to the one-off migration
# command (DEPLOYMENT.md); the backend refuses to start in production with it set.
